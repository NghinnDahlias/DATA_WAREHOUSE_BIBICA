# Frontend uses same-origin /api/v1. Vite proxies /api to 127.0.0.1:8001.
# No mock runtime or VITE_USE_MOCK switch is implemented.
# Production hosting must provide the equivalent /api reverse proxy.

# Optional terminal environment override for a different local API port:
# BIBICA_API_PROXY=http://127.0.0.1:8002
